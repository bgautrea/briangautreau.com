---
import { Picture } from 'astro:assets';
import headshot from '../assets/headshot.png';

interface Props {
  width?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { width = 440, loading = 'eager', class: cls } = Astro.props;
const height = Math.round(width * (headshot.height / headshot.width));
---
<Picture
  src={headshot}
  alt="Brian Gautreau"
  widths={[width, width * 2]}
  sizes={`(max-width: 860px) 320px, ${width}px`}
  formats={['avif', 'webp']}
  fallbackFormat="png"
  loading={loading}
  decoding="async"
  pictureAttributes={{ class: cls }}
  width={width}
  height={height}
/>

<style is:global>
  picture > img {
    border-radius: 4px;
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
